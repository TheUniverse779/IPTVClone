<?xml version="1.0" encoding="utf-8"?>
<!-- Mirrors design/components.css -->
<resources>
    <!-- ===== Text ===== -->
    <style name="Text" parent="">
        <item name="android:fontFamily">@font/barlow</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/t_14</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Text.Body" />
    <style name="Text.Body.Secondary"><item name="android:textColor">@color/text_2</item></style>
    <style name="Text.Hint">
        <item name="android:textColor">@color/text_3</item>
        <item name="android:textSize">@dimen/t_12</item>
    </style>
    <style name="Text.Caption">
        <item name="android:textColor">@color/text_2</item>
        <item name="android:textSize">@dimen/t_12</item>
    </style>
    <style name="Text.RowTitle">
        <item name="android:textSize">@dimen/t_16</item>
        <item name="android:fontFamily">@font/barlow_semibold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Text.Label">
        <item name="android:fontFamily">@font/barlow_medium</item>
        <item name="android:textSize">@dimen/t_14</item>
    </style>
    <style name="Text.Semibold"><item name="android:fontFamily">@font/barlow_semibold</item></style>
    <!-- Barlow Condensed: titles and numerals -->
    <style name="Text.Cond">
        <item name="android:fontFamily">@font/barlow_condensed_semibold</item>
        <item name="android:textSize">@dimen/t_20</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="Text.Cond.Toolbar">
        <item name="android:textSize">@dimen/t_20</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Text.Cond.Section"><item name="android:textSize">@dimen/t_20</item></style>
    <style name="Text.Cond.Dialog">
        <item name="android:textSize">@dimen/t_24</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="Text.Cond.Hero">
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:textSize">@dimen/t_32</item>
        <item name="android:lineSpacingMultiplier">0.95</item>
    </style>
    <style name="Text.Cond.Number">
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:textSize">26sp</item>
    </style>
    <style name="Text.Link">
        <item name="android:textColor">@color/accent</item>
        <item name="android:fontFamily">@font/barlow_semibold</item>
    </style>

    <!-- ===== Buttons ===== -->
    <style name="Btn" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/h_button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/r_ctl</item>
        <item name="android:textSize">@dimen/t_16</item>
        <item name="android:fontFamily">@font/barlow_semibold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">20dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>
    <style name="Btn.Primary">
        <item name="backgroundTint">@color/btn_primary_bg</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="iconTint">@color/white</item>
    </style>
    <style name="Btn.Tonal">
        <item name="backgroundTint">@color/surface_2</item>
        <item name="android:textColor">@color/text</item>
        <item name="iconTint">@color/text</item>
    </style>
    <style name="Btn.Danger">
        <item name="backgroundTint">@color/danger_bg</item>
        <item name="android:textColor">@color/danger_text</item>
    </style>
    <style name="Btn.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/barlow_semibold</item>
        <item name="android:textSize">@dimen/t_14</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">40dp</item>
    </style>
    <style name="Btn.Text.Muted"><item name="android:textColor">@color/text_2</item></style>
    <style name="Btn.Small">
        <item name="android:minHeight">36dp</item>
        <item name="android:textSize">@dimen/t_14</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="iconSize">16dp</item>
    </style>
    <style name="Btn.Small.Primary">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
    </style>
    <style name="Btn.Small.Tonal">
        <item name="backgroundTint">@color/surface_2</item>
        <item name="android:textColor">@color/text</item>
        <item name="iconTint">@color/text</item>
    </style>

    <!-- Round 40dp icon button -->
    <style name="IconBtn">
        <item name="android:layout_width">@dimen/icon_btn</item>
        <item name="android:layout_height">@dimen/icon_btn</item>
        <item name="android:padding">8dp</item>
        <item name="android:background">@drawable/bg_icon_btn</item>
        <item name="android:scaleType">centerInside</item>
        <item name="tint">@color/text</item>
    </style>
    <style name="IconBtn.Boxed"><item name="android:background">@drawable/bg_icon_btn_boxed</item></style>

    <!-- ===== Inputs ===== -->
    <style name="Input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/h_input</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_3</item>
        <item name="android:textSize">@dimen/t_14</item>
        <item name="android:fontFamily">@font/barlow</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textCursorDrawable">@drawable/cursor</item>
    </style>
    <style name="FieldLabel" parent="Text.Label">
        <item name="android:layout_marginBottom">6dp</item>
    </style>
    <style name="FieldHelper" parent="Text.Hint">
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <!-- ===== Chips / segments ===== -->
    <style name="Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1.5dp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipCornerRadius">16dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="android:textAppearance">@style/Text.Label</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconTint">@color/chip_text</item>
        <item name="chipIconSize">16dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <style name="Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
        <item name="trackDecorationTint">@android:color/transparent</item>
    </style>

    <style name="LiveBadge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:background">@drawable/bg_live</item>
        <item name="android:drawableStart">@drawable/bg_dot_white</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:paddingStart">7dp</item>
        <item name="android:paddingEnd">7dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Crest">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_crest</item>
        <item name="android:fontFamily">@font/barlow_condensed_bold</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SegItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_seg_item</item>
        <item name="android:fontFamily">@font/barlow_semibold</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/seg_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="PlayerBtn">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/white</item>
    </style>
    <style name="PlayerTool" parent="Text.Semibold">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/player_tool</item>
        <item name="android:drawableTint">@color/player_tool</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- ===== Bottom bar ===== -->
    <style name="BottomTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
    <style name="BottomTabIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="tint">@color/tab_tint</item>
        <item name="android:duplicateParentState">true</item>
    </style>
    <style name="BottomTabText" parent="Text.Semibold">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/tab_tint</item>
        <item name="android:duplicateParentState">true</item>
    </style>

    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/surface_2</item>
    </style>
</resources>
