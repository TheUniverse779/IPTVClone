<?xml version="1.0" encoding="utf-8"?>
<!-- IPTV sources are commonly plain http; TLS is still validated normally for https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
