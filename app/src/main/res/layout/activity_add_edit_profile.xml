<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <include android:id="@+id/toolbar" layout="@layout/layout_toolbar" />

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="24dp">

            <FrameLayout android:layout_width="104dp" android:layout_height="104dp" android:layout_gravity="center_horizontal" android:layout_marginTop="4dp" android:layout_marginBottom="20dp">
                <TextView android:id="@+id/avatar" android:layout_width="96dp" android:layout_height="96dp" android:fontFamily="@font/barlow_condensed_bold" android:gravity="center" android:textColor="@color/white" android:textSize="40sp" />
                <ImageView android:id="@+id/avatarIcon" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="30dp" android:layout_marginTop="30dp" android:src="@drawable/ic_user" android:visibility="gone" app:tint="@color/white" />
                <FrameLayout android:id="@+id/btnColor" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="bottom|end" android:background="@drawable/bg_badge_round_2" android:foreground="?attr/selectableItemBackgroundBorderless">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center" android:src="@drawable/ic_edit" />
                </FrameLayout>
            </FrameLayout>

            <include android:id="@+id/form" layout="@layout/form_import_xtream" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
