<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Video area: 16:9 in portrait, full screen in landscape (ConstraintSet swap in code) -->
    <FrameLayout
        android:id="@+id/videoBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/black"
        app:layout_constraintDimensionRatio="H,16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:resize_mode="fit"
            app:shutter_background_color="@color/black"
            app:surface_type="surface_view"
            app:use_controller="false" />

        <!-- gesture layer -->
        <View android:id="@+id/gestureLayer" android:layout_width="match_parent" android:layout_height="match_parent" />

        <include android:id="@+id/ctl" layout="@layout/layout_player_controller" />

        <ProgressBar android:id="@+id/buffering" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center" android:indeterminateTint="@color/accent" android:visibility="gone" />

        <TextView android:id="@+id/gesturePill" style="@style/Text.Semibold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|center_horizontal" android:layout_marginTop="16dp" android:background="@drawable/bg_pill_dark" android:drawablePadding="8dp" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingTop="6dp" android:paddingEnd="14dp" android:paddingBottom="6dp" android:textColor="@color/white" android:textSize="13sp" android:visibility="gone" />

        <ImageButton android:id="@+id/btnUnlock" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_vertical|start" android:layout_marginStart="16dp" android:background="@drawable/bg_round_dark" android:contentDescription="@string/lock" android:src="@drawable/ic_lock" android:visibility="gone" app:tint="@color/white" />

        <include android:id="@+id/err" layout="@layout/layout_player_error" android:visibility="gone" />

        <!-- landscape side channel panel -->
        <LinearLayout
            android:id="@+id/sidePanel"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@drawable/bg_side_panel"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="4dp">
                <TextView android:id="@+id/sideTitle" style="@style/Text.Cond" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textSize="17sp" />
                <ImageButton android:id="@+id/sideClose" style="@style/IconBtn" android:src="@drawable/ic_close" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvSide" android:layout_width="match_parent" android:layout_height="match_parent" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>
    </FrameLayout>

    <!-- Portrait "below" area -->
    <LinearLayout
        android:id="@+id/below"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/bg"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/videoBox">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:paddingBottom="10dp">
            <include android:id="@+id/nowLogo" layout="@layout/view_logo" android:layout_width="@dimen/logo" android:layout_height="@dimen/logo" android:layout_marginEnd="12dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/nowTitle" style="@style/Text.Cond" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="22sp" />
                <TextView android:id="@+id/nowSub" style="@style/Text.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <ImageButton android:id="@+id/nowFav" style="@style/IconBtn.Boxed" android:src="@drawable/ic_heart" app:tint="@color/fav_tint" />
        </LinearLayout>

        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
            <com.google.android.material.chip.ChipGroup android:id="@+id/tools" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="12dp" app:singleLine="true" />
        </HorizontalScrollView>

        <LinearLayout android:id="@+id/resumeCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp" android:visibility="gone">
            <TextView android:id="@+id/resumeTitle" style="@style/Text.Semibold" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView style="@style/Text.Hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/resume_note" />
        </LinearLayout>

        <include android:id="@+id/secList" layout="@layout/layout_section_header" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_weight="1" android:background="@drawable/bg_list_card" android:clipToOutline="true" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
